<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="508.0" prefWidth="805.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.MainController">
	<top>
		<MenuBar>
	<menus>
		<Menu mnemonicParsing="false" text="File">
			<items>
				<MenuItem mnemonicParsing="false" onAction="#openReport"
					text="Open Inventory Report" />
					
				<MenuItem mnemonicParsing="false" onAction="#editProductsClicked"
					text="Edit Product List" />
					
				<MenuItem mnemonicParsing="false"
					onAction="#openReportFor1Beef"
					text="Open Inventory Report for 1 Beef Product" />

				<MenuItem mnemonicParsing="false"
					onAction="#openReportFor1Pork"
					text="Open Inventory Report for 1 Pork Product" />


			</items>
		</Menu>
	</menus>
</MenuBar>
	</top>
	<center>
		<TabPane fx:id="tabpane" prefHeight="415.0" prefWidth="799.0" side="BOTTOM" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
			<tabs>
				<Tab fx:id="manualtab" text="Manual">
					<content>
						<VBox alignment="CENTER" spacing="12">

							<children>
								<Label fx:id="messageLabel" alignment="CENTER" text="" />
								<!-- GS1-128 inputs (hidden unless GS1-128 selected) -->
								<HBox alignment="CENTER" spacing="8">
									<children>
										<VBox prefHeight="99.0" prefWidth="190.0">
											<children>
												<Label prefHeight="30.0" text="Product code 6 digits" />
												<TextField fx:id="productCodeField" prefHeight="30.0" />
												<Button mnemonicParsing="false" onAction="#onLookupBeefClicked" prefHeight="30.0" text="Lookup Beef Product Id" />
                                    <Button mnemonicParsing="false" onAction="#onLookupPorkClicked" prefHeight="30.0" text="Lookup Pork Product Id" />
											</children>
										</VBox>
										<VBox prefHeight="120.0" prefWidth="200.0">
											<children>
												<Label prefHeight="30.0" text="Product Group" />
												<TextField fx:id="groupField" prefHeight="30.0" />
											</children>
										</VBox>
										<VBox prefHeight="120.0" prefWidth="200.0">
											<children>
												<Label prefHeight="30.0" text="Product Description" />
												<TextField fx:id="descriptionField" prefHeight="30.0" />
											</children>
										</VBox>
										<VBox prefHeight="120.0" prefWidth="200.0">
											<children>
												<Label prefHeight="30.0" text="Weight (lbs) WW.www " />
												<TextField fx:id="weightField" prefHeight="30.0" />
											</children>
										</VBox>
									</children>
								</HBox>

								<HBox alignment="CENTER" spacing="8">
									<children>
										<Button onAction="#onGenerateClicked" text="Generate" />
										<Button onAction="#onPrintWindowsClicked" text="Print Windows Printer" />
										<Button onAction="#onPrintZebraClicked" text="Print Zebra Printer" />
									</children>
								</HBox>

								<ImageView fx:id="barcodeView" fitHeight="120" fitWidth="480" preserveRatio="true" />
								<Label fx:id="contentLabel" text="" BorderPane.alignment="CENTER" />
							</children>
						</VBox>

					</content>
				</Tab>
				<Tab text="Batch">
					<content>
						<BorderPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
							<center>
								<TableView fx:id="tableView" prefHeight="4000" prefWidth="4000">

								</TableView>
							</center>
							<bottom>
								<VBox alignment="CENTER" BorderPane.alignment="CENTER">
									<children>
										<HBox alignment="TOP_CENTER" prefWidth="200.0" spacing="20.0">
											<children>
												<Button fx:id="printbutton" alignment="TOP_RIGHT" mnemonicParsing="false" onAction="#printSelected" text="Print Selected" />
												<Button mnemonicParsing="false" onAction="#printNext20" text="Print Next 20 Unprinted" />
												<Button mnemonicParsing="false" onAction="#printNext40" text="Print Next 40 Unprinted" />
												<Button mnemonicParsing="false" onAction="#printAll" text="Print All Unprinted" />
											</children>
										</HBox>
										<Label fx:id="spreadsheetNameLabel" text="spreadsheet.xls">
										</Label>
									</children>
								</VBox>
							</bottom>
						</BorderPane>
					</content>
				</Tab>
			</tabs>
		</TabPane>
	</center>
</BorderPane>
