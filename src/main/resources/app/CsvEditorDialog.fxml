<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="app.CsvEditorController">

	<!-- Center: TableView for CSV data -->
	<center>
		<BorderPane>
			<center>
				<TableView fx:id="csvTableView" editable="true"
					style="-fx-control-inner-background: #f9f9f9;">
					<!-- Columns will be generated dynamically -->
				</TableView>
			</center>

		</BorderPane>
	</center>

	<!-- Bottom: Action buttons -->
	<bottom>
		<ButtonBar style="-fx-padding: 10">
			<buttons>
				<Button text="Add Row" onAction="#handleAddRow" />
				<Button text="Delete Selected Row"
					onAction="#handleDeleteRow" />
				<Button text="Save CSV" onAction="#handleSaveCsv"
					style="-fx-font-size: 12; -fx-padding: 8" />
				<Button text="Cancel" onAction="#handleCancel" />
			</buttons>
		</ButtonBar>
	</bottom>
</BorderPane>